FROM ghcr.io/astral-sh/uv:0.10.12 AS uv

# The API image is built first and already contains the locked production
# environment. This overlay adds only the isolated evaluation dependency group
# to the Worker image, keeping API/parser images smaller and deployments fast.
FROM agenthub-api:2.0.0 AS evaluation-worker

ARG UV_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app/backend \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_INDEX_URL=${UV_INDEX_URL}

WORKDIR /app

USER root
COPY --from=uv /uv /uvx /bin/
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --locked --active --no-dev --no-install-project --no-default-groups --group eval \
    && chown -R app:app /app/.venv
COPY --chown=app:app backend /app/backend

USER app

EXPOSE 8080

CMD ["celery", "-A", "infrastructure.celery_app", "worker", "--loglevel=info", "--concurrency=1", "-Q", "default,maintenance,update,evaluation"]
