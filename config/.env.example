# Deployment identity. config/.env is generated locally and must never be committed.
COMPOSE_PROJECT_NAME=knowledgeforge

# Online model providers (both credentials are required for full RAG ingestion/QA).
# Text generation: Xiaomi MiMo via its OpenAI-compatible endpoint.
MIMO_API_KEY=your-mimo-api-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
# Generation thinking mode: default (provider default) / disabled (faster QA answers).
LLM_THINKING_MODE=disabled
# Legacy aliases retained for older workers; keep values aligned with MIMO_*.
DEEPSEEK_API_KEY=your-mimo-api-key-here
DEEPSEEK_BASE_URL=https://api.xiaomimimo.com/v1
DEEPSEEK_MODEL=mimo-v2.5-pro
# Embeddings and image/PDF visual understanding: Alibaba Cloud Model Studio.
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# Maximum texts per compatible embeddings request; DashScope text-embedding-v4 allows 10.
EMBEDDING_BATCH_SIZE=10
# Native retrieval remains framework-neutral. Hybrid defaults to Dense + BM25 + Claim Graph.
# Allowed: dense, dense_graph, dense_bm25, dense_bm25_graph.
QA_RETRIEVAL_STRATEGY=dense_bm25_graph
QA_BM25_INDEX_PATH=./data/bm25
QA_BM25_SCHEMA_VERSION=native-bm25-v1
QA_BM25_TOKENIZER_VERSION=unicode-cjk-bigram-v1
QA_BM25_K1=1.5
QA_BM25_B=0.75
QA_BM25_TOP_K=5
# Per-rewritten-query dense candidate cap; deeper pools cover broad "scope/catalog" questions.
QA_VECTOR_TOP_K=10
QA_RRF_K=60
QA_RRF_VECTOR_WEIGHT=1.0
QA_RRF_BM25_WEIGHT=1.0
QA_RRF_GRAPH_WEIGHT=1.05
QA_CONTEXT_LIMIT=10
# Same-document chunks appended after a TOC-bearing top chunk (broad scope questions).
QA_SCOPE_EXPANSION_CHUNKS=5

# Server-only finance scope for automated evaluation Fixture validation.
# Set to the exact non-interactive finance department ID; leave empty to fail closed.
EVALUATION_FIXTURE_FINANCE_DEPARTMENT_ID=

# Evidence qualification rollout: off / shadow / enforce.
# Keep off until reviewed no-answer baselines and calibration gates pass.
QA_EVIDENCE_GATE_MODE=off
QA_EVIDENCE_POLICY_VERSION=evidence-composite-v2
QA_EVIDENCE_CALIBRATION_VERSION=qualification-boundaries-v2
QA_EVIDENCE_CANDIDATE_BUDGET_VERSION=candidate-budget-v1
QA_EVIDENCE_CANDIDATE_LIMIT=8
QA_EVIDENCE_BACKGROUND_THRESHOLD=0.35
QA_EVIDENCE_GRAY_ZONE_LOWER=0.45
QA_EVIDENCE_GRAY_ZONE_UPPER=0.65
QA_EVIDENCE_DIRECT_THRESHOLD=0.75
QA_STRUCTURED_ANSWER_SCHEMA_VERSION=structured-answer-v1
QA_GROUNDING_POLICY_VERSION=grounding-v1

# Optional CrossEncoder: disabled / remote / local. Disabled adds no model dependency.
QA_CROSS_ENCODER_MODE=disabled
QA_CROSS_ENCODER_VERSION=disabled-v1
QA_CROSS_ENCODER_MODEL=qwen3-rerank
QA_CROSS_ENCODER_CANDIDATE_LIMIT=10
QA_CROSS_ENCODER_CONTEXT_LIMIT=8
# Cap one source document's chunks in the reranked context so conflicting/comparative
# evidence from other documents is not crowded out.
QA_RERANK_MAX_PER_DOCUMENT=5
QA_CROSS_ENCODER_TIMEOUT_SECONDS=2
# qwen3-rerank compatible endpoint; fill in the workspace-specific host when enabling remote mode.
QA_CROSS_ENCODER_REMOTE_ENDPOINT=
VISION_MODEL=qwen3-vl-flash

# QA safety: builtin (default, no optional dependency), monitor, or enforce.
# monitor/enforce require the locked backend `safety-poc` group or an approved
# injected ContentValidator. Enforce fails closed on validator timeout/error.
QA_SAFETY_MODE=builtin
QA_GUARDRAIL_TIMEOUT_SECONDS=1
QA_GUARDRAIL_RULE_VERSION=builtin-v1
# Future model-selected tools are deny-by-default; this switch denies all.
TOOL_GOVERNANCE_KILL_SWITCH=false
TOOL_POLICY_VERSION=tool-policy-v1

# PostgreSQL is the only runtime source of truth for authorization and business facts.
SECURITY_STATE_TIMEOUT_SECONDS=1
SECURITY_STATE_MAX_RECORD_BYTES=65536
SECURITY_STATE_ALLOW_LOCAL_BOOTSTRAP=false
TASK_REGISTRY_TTL_SECONDS=691200

# Run the explicit migration command before starting the API; the application never
# creates production schema. Replace the placeholder credentials outside source control.
DATABASE_URL=postgresql+psycopg2://knowledgeforge:replace-me@localhost:5432/knowledgeforge
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=5000
# Release-workflow / company-global Gate records require migration schema version 3.
DATABASE_REQUIRED_SCHEMA_VERSION=3
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY
WEBHOOK_SECRET_KEY_REFERENCE=local-fernet-v1
ALLOW_DEMO_DEFAULT_ORG_REGISTRATION=false
QA_HISTORY_RETENTION_DAYS=365
QA_CACHE_TTL_SECONDS=3600
QA_CACHE_MIN_CONFIDENCE=0.75
QA_SEMANTIC_CACHE_MODE=shadow
QA_SEMANTIC_CANDIDATE_LIMIT=3
QA_SEMANTIC_CONFIRMATION_TTL_SECONDS=300
QA_SEMANTIC_SIMILARITY_THRESHOLD=0.9

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Vector Store: chroma | pgvector
VECTOR_STORE_TYPE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# PGVector (if VECTOR_STORE_TYPE=pgvector). Inject a secret-bearing DSN outside source control.
PGVECTOR_DSN=

# Kafka (CDC)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DOC_CHANGES=doc-changes
KAFKA_TOPIC_KG_UPDATES=kg-updates

# Docker Compose host bindings, resource bounds, and log rotation (non-secret).
# API docs/API traffic are reachable on 8080; data-management services stay loopback-only.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=5173
API_BIND_ADDRESS=0.0.0.0
MANAGEMENT_BIND_ADDRESS=127.0.0.1
# Host-side ports. Change these only to resolve a local port collision.
POSTGRES_BIND_PORT=5432
NEO4J_HTTP_BIND_PORT=7474
NEO4J_BOLT_BIND_PORT=7687
CHROMA_BIND_PORT=8000
REDIS_BIND_PORT=6379
KAFKA_BIND_PORT=9092
API_BIND_PORT=8080
# Mixed local worker: keep memory-intensive updates serialized by default.
WORKER_CONCURRENCY=1
POSTGRES_PORT=5432
NEO4J_HEAP_INITIAL_SIZE=256m
NEO4J_HEAP_MAX_SIZE=512m
NEO4J_PAGECACHE_SIZE=256m
KAFKA_HEAP_INITIAL_MB=256
KAFKA_HEAP_MAX_MB=512
REMOTE_WORKER_CONCURRENCY=1
REMOTE_PARSER_CONCURRENCY=1
REMOTE_WORKER_MAX_TASKS_PER_CHILD=10
REMOTE_PARSER_MAX_TASKS_PER_CHILD=3
COMPOSE_LOG_MAX_SIZE=10m
COMPOSE_LOG_MAX_FILES=3
# Remote Docker builds inherit these tested download sources. They affect only
# image construction; they do not change the configured model-provider endpoint.
BUILD_APT_MIRROR=https://mirrors.tencentyun.com/debian
BUILD_NPM_REGISTRY=https://registry.npmmirror.com
# uv/Python package mirror used during image builds.
BUILD_PYPI_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
# Replace in config/.env; never commit the real value.
POSTGRES_PASSWORD=replace-me

# API
APP_ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8080
SERVICE_NAME=knowledgeforge
LOG_LEVEL=INFO

# Documents (metadata is stored in PostgreSQL; UPLOAD_DIR contains file payloads).
UPLOAD_DIR=./uploads
# Optional legacy/local SQLite catalog adapter path; production uses PostgreSQL.
DOCUMENT_CATALOG_PATH=
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_BATCH_FILES=50
UPLOAD_TENANT_QUOTA_BYTES=5368709120
UPLOAD_STREAM_CHUNK_BYTES=1048576
UPLOAD_MAX_ARCHIVE_ENTRIES=2000
UPLOAD_MAX_ARCHIVE_UNCOMPRESSED_BYTES=536870912
UPLOAD_MAX_ARCHIVE_COMPRESSION_RATIO=100
UPLOAD_MAX_PDF_PAGES=500
UPLOAD_MAX_IMAGE_PIXELS=40000000
UPLOAD_MAX_SPREADSHEET_ROWS=100000
UPLOAD_MAX_TEXT_CHARACTERS=5000000
# 0 deletes detected malicious files after recording a minimal denial.
UPLOAD_QUARANTINE_RETENTION_HOURS=0
UPLOAD_STAGING_RETENTION_HOURS=24
# Enable only after an approved external scanner adapter is configured.
UPLOAD_REQUIRE_EXTERNAL_SCANNER=false

# Document chunking (recursive is the stable default; semantic is gray mode)
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=400
CHUNK_OVERLAP=128
SEMANTIC_CHUNK_PERCENTILE=95
SEMANTIC_CHUNK_MIN_SIZE=200
SEMANTIC_CHUNK_MAX_SIZE=512

# Persistent security audit log
# Production storage must survive pod replacement, be restricted to the API
# service account, and support advisory file locking when replicas share it.
AUDIT_LOG_FILE=./logs/audit.log
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_LOG_BACKUP_COUNT=7
# Cleanup/export policy input; request handling never deletes records by age.
AUDIT_LOG_RETENTION_DAYS=90

# Redis
REDIS_URL=redis://localhost:6379/0
READINESS_PROBE_TIMEOUT_SECONDS=2

# Sensitive-route rate limiting. Production must use a shared backend.
RATE_LIMIT_STORAGE_URI=memory://
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For.
RATE_LIMIT_TRUSTED_PROXY_CIDRS=
RATE_LIMIT_AUTH_PUBLIC=10/minute
RATE_LIMIT_QA_ASK=100/minute
RATE_LIMIT_DOC_UPLOAD=10/minute
RATE_LIMIT_DOC_BATCH_UPLOAD=5/minute
RATE_LIMIT_PASSWORD=5/minute
RATE_LIMIT_API_KEY_MUTATION=20/minute
RATE_LIMIT_WEBHOOK_TEST=10/minute

# Celery（异步任务；Docker Compose 会使用容器内地址覆盖这些值）
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# Auth (JWT)
# Production: inject a generated 32-byte-or-longer secret from the approved secret manager.
# The placeholder is intentionally rejected when APP_ENVIRONMENT=production.
AUTH_SECRET_KEY=REPLACE_VIA_SECRET_MANAGER
# Only for explicitly local development/test; never enable in production.
AUTH_ALLOW_INSECURE_LOCAL_DEVELOPMENT=false
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
# API Keys never have unlimited lifetime. Explicit values outside min/max fail.
AUTH_API_KEY_MIN_EXPIRY_DAYS=1
AUTH_API_KEY_DEFAULT_EXPIRY_DAYS=30
AUTH_API_KEY_MAX_EXPIRY_DAYS=90
AUTH_API_KEY_STALE_WARNING_DAYS=30
AUTH_API_KEY_EXPIRY_WARNING_DAYS=7
AUTH_REDIS_URL=redis://localhost:6379/1
AUTH_BCRYPT_ROUNDS=12

# Offline Ragas evaluation judge (optional; isolated from the online application model).
# The RAGAS Judge uses an isolated OpenAI-compatible endpoint. MiMo JSON
# Object mode is the default; explicit evaluator values may still select
# another compatible provider for a controlled migration or comparison.
EVAL_OPENAI_API_KEY=your-mimo-api-key-here
EVAL_OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
EVAL_OPENAI_MODEL=mimo-v2.5-pro

# External dependency execution budgets (seconds; retries are additional attempts)
VECTOR_CONNECT_TIMEOUT_SECONDS=2
VECTOR_READ_TIMEOUT_SECONDS=5
VECTOR_TOTAL_TIMEOUT_SECONDS=8
VECTOR_MAX_RETRIES=1
GRAPH_CONNECT_TIMEOUT_SECONDS=2
GRAPH_READ_TIMEOUT_SECONDS=5
GRAPH_TOTAL_TIMEOUT_SECONDS=8
GRAPH_MAX_RETRIES=1
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_TOTAL_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
WEBHOOK_CONNECT_TIMEOUT_SECONDS=2
WEBHOOK_READ_TIMEOUT_SECONDS=5
WEBHOOK_TOTAL_TIMEOUT_SECONDS=15
WEBHOOK_MAX_RETRIES=3
# Webhook outbound security: allow public HTTPS/443 only.
# Comma-separated exact hostnames; leave blank for any otherwise public host.
WEBHOOK_ALLOWED_HOSTS=
# Local callbacks require BOTH APP_ENVIRONMENT=development|test and this explicit opt-in.
WEBHOOK_ALLOW_HTTP_IN_LOCAL_DEVELOPMENT=false
WEBHOOK_RESPONSE_BODY_LIMIT_BYTES=65536
